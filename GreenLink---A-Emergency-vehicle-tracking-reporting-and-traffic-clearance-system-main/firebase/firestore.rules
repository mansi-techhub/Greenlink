rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Alerts collection rules
    match /alerts/{alertId} {
      // Drivers can create alerts; anyone can read them (for local tracking)
      // In a production app, you might restrict 'read' to authenticated staff
      allow read: if true; 
      allow create: if true;
      
      // Only authenticated staff (Incharge/Officer) can update alerts
      allow update: if request.auth != null;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
